# Usando uma versão LTS mais estável para evitar problemas de corepack/pnpm
FROM node:18.17.1

# Diretório de trabalho
WORKDIR /app

# Ativar o corepack (necessário para usar pnpm corretamente)
RUN corepack enable pnpm

# Instalar wrangler globalmente (após corepack estar habilitado)
RUN npm install -g wrangler

# Copiar arquivos de dependência
COPY package.json pnpm-lock.yaml ./

# Instalar dependências sem verificação de integridade
RUN pnpm install --no-verify-store-integrity

# Copiar o restante do código-fonte
COPY . .

# Garantir permissões e formato correto para o script bindings.sh
RUN tr -d '\r' < bindings.sh > bindings.tmp && \
    mv bindings.tmp bindings.sh && \
    chmod +x bindings.sh

# Build da aplicação
RUN pnpm build

# Expor a porta usada pela aplicação
EXPOSE 5173

# Variáveis de ambiente
ENV NODE_ENV=production \
    RUNNING_IN_DOCKER=true

# Comando padrão para subir o app
CMD ["pnpm", "run", "dockerstart"]
